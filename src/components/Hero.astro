---
const cells: { x: number; y: number; sz: number; color: string; op: number }[] = [];
for (let i = 0; i < 80; i++) {
  cells.push({
    x: (i * 73 + 19) % 1400,
    y: (i * 109 + 41) % 900,
    sz: i % 7 === 0 ? 10 : i % 4 === 0 ? 6 : 4,
    color: i % 9 === 0 ? "#CB44EF" : "#7B2ADB",
    op: i % 3 === 0 ? 0.12 : 0.07,
  });
}
---

<section class="hero">
  <div class="hero-bg-pattern" aria-hidden="true">
    <svg
      width="100%"
      height="100%"
      viewBox="0 0 1400 900"
      preserveAspectRatio="xMidYMid slice"
      style="position:absolute;inset:0"
    >
      {
        cells.map((c, i) => (
          <rect key={i} x={c.x} y={c.y} width={c.sz} height={c.sz} fill={c.color} opacity={c.op} />
        ))
      }
    </svg>
  </div>
  <div class="container">
    <div class="hero-inner">
      <span class="hero-badge"><span class="dot"></span>Security Through Education</span>
      <h1>
       Cybersecurity made <span class="gradient-text">Practical</span>
      </h1>
      <p class="hero-sub">
        QueryLock makes cybersecurity easier to understand with guides everyone can follow and
        hands-on security training built around your team&rsquo;s needs. We help learners build real
        confidence, and we help teams write secure code from the start.
      </p>
      <div class="hero-ctas">
        <a href="/training#contact" class="btn btn-primary btn-lg">
          Schedule Training
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"></path></svg
          >
        </a>
        <a href="https://querylock.gumroad.com/" target="_blank" class="btn btn-outline btn-lg">Explore the Guides</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 64px 0 48px;
    overflow: hidden;
    background:
      radial-gradient(
        ellipse 90% 60% at 50% 0%,
        color-mix(in srgb, var(--ql-magenta) 8%, transparent),
        transparent 70%
      ),
      radial-gradient(
        ellipse 60% 50% at 90% 30%,
        color-mix(in srgb, var(--ql-violet) 10%, transparent),
        transparent 70%
      ),
      var(--ql-white);
  }
  @media (min-width: 760px) {
    .hero {
      padding: 80px 0 56px;
    }
  }

  .hero-bg-pattern {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.5;
  }

  .hero-inner {
    position: relative;
    text-align: center;
    max-width: 920px;
    margin: 0 auto;
  }
  .hero-inner h1 {
    font-weight: 800;
    font-size: clamp(40px, 7.2vw, 84px);
    line-height: 1.02;
    letter-spacing: -0.025em;
    margin: 24px 0;
    text-wrap: balance;
  }

  .hero-sub {
    font-size: 18px;
    line-height: 1.55;
    color: var(--fg-2);
    margin: 0 auto 40px;
    max-width: 620px;
  }
  @media (min-width: 760px) {
    .hero-sub {
      font-size: 20px;
    }
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  /* Tighten spacing between hero and the next section on the homepage */
  :global(.hero + .section) {
    padding-top: 48px;
  }
  @media (min-width: 760px) {
    :global(.hero + .section) {
      padding-top: 64px;
    }
  }
</style>
