---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import FreeResources from "../components/FreeResources.astro";
import Nav from "../components/Nav";
import GuideSeries from "../components/GuideSeries";
import Newsletter from "../components/Newsletter";
import FinalCTA from "../components/FinalCTA.astro";
---

<Layout
  title="Learning — QueryLock"
  description="Short, practical guides that make cybersecurity and AI finally click. No technical background needed."
>
  <Nav active="learning" client:load />
  <main>
    <section class="page-hero section-lg" id="guides">
      <div class="container">
        <div class="page-hero-inner">
          <span class="hero-badge"><span class="dot"></span>The guide catalog</span>
          <h1>Make security finally <span class="gradient-text">click.</span></h1>
          <p class="page-hero-sub">
            Explore short, practical guides that make complex topics finally click. The only
            prerequisite is curiosity &mdash; no technical background needed.
          </p>
          <a
            href="https://gumroad.com"
            target="_blank"
            rel="noopener"
            class="btn btn-primary btn-lg mb-5"
          >
            View guides on Gumroad
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"><path d="M7 17L17 7M7 7h10v10"></path></svg
            >
          </a>
          <p class="page-hero-note">
            Don't see the guide you want? Request one at <a href="mailto:info@querylock.com"
              >info@querylock.com</a
            >
          </p>
        </div>
      </div>
    </section>

    <!--<FinalCTA />-->
  </main>
  <Footer />
</Layout>

<style>
  .page-hero {
    background:
      radial-gradient(
        ellipse 80% 60% at 50% 0%,
        color-mix(in srgb, var(--ql-violet) 10%, transparent) 0%,
        transparent 70%
      ),
      var(--ql-white);
    padding: 64px 0;
  }

  .page-hero-inner {
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
  }
  .page-hero-inner h1 {
    font-weight: 800;
    font-size: clamp(36px, 6vw, 72px);
    letter-spacing: -0.025em;
    line-height: 1.04;
    margin: 0;
  }

  .page-hero-sub {
    font-size: clamp(16px, 1.6vw, 19px);
    line-height: 1.65;
    color: var(--fg-2);
    margin: 0;
  }

  .page-hero-note {
    font-size: 14px;
    color: var(--fg-3);
    margin: 0;
  }
  .page-hero-note a {
    color: var(--ql-violet);
    text-decoration: none;
  }
  .page-hero-note a:hover {
    text-decoration: underline;
  }
</style>
