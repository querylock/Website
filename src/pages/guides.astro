---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav";
import { guides } from "../data/guides";
---

<Layout
  title="Guides | QueryLock"
  description="Every QueryLock guide, explained on its own page. Read what each one covers before you buy."
>
  <Nav active="learning" client:load />
  <main>
    <section class="page-hero section-lg">
      <div class="container">
        <div class="page-hero-inner">
          <span class="hero-badge"><span class="dot"></span>The guide catalog</span>
          <h1>Start learning now</h1>
          <p class="page-hero-sub">
            Short, practical guides that make complex topics easier to understand. Read what each
            one covers before you buy, then get instant access on Gumroad.
          </p>
        </div>
      </div>
    </section>

    <section class="guide-catalog section section-lg">
      <div class="container">
        <div class="catalog-grid">
          {
            guides.map((guide) => {
              const priceLabel = guide.isPWYW ? "Free" : `$${(guide.priceCents / 100).toFixed(2)}`;
              return (
                <a href={`/guides/${guide.slug}`} class="catalog-card">
                  <span class="pill pill-soft catalog-eyebrow">{guide.eyebrow}</span>
                  <h2>{guide.name}</h2>
                  <p>{guide.metaDescription}</p>
                  <div class="catalog-footer">
                    <div class="catalog-meta">
                      <span>{priceLabel}</span>
                      <span class="catalog-meta-dot" aria-hidden="true" />
                      <span>~{guide.readMinutes} min read</span>
                    </div>
                    <span class="catalog-link">
                      Read more
                      <svg
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                      >
                        <path d="M5 12h14M13 6l6 6-6 6" />
                      </svg>
                    </span>
                  </div>
                </a>
              );
            })
          }
        </div>
      </div>
    </section>

    <section class="request-section section section-lg" id="request-guide">
      <div class="container">
        <div class="request-card">
          <div class="request-copy">
            <h2>Request a guide.</h2>
            <p>
              Don't see your topic? Tell us what you want to learn and we'll consider it for a
              future guide.
            </p>
          </div>

          <form
            class="request-form"
            name="guide-request"
            method="POST"
            data-netlify="true"
            netlify-honeypot="request-bot-field"
          >
            <input type="hidden" name="form-name" value="guide-request" />
            <p class="request-hp">
              <label>Don't fill this out if you're human: <input name="request-bot-field" /></label>
            </p>

            <div class="form-field">
              <label for="rf-topic">Guide topic</label>
              <input
                type="text"
                id="rf-topic"
                name="topic"
                placeholder="e.g. How VPNs Work"
                required
              />
            </div>

            <div class="form-field">
              <label for="rf-email">Email (optional)</label>
              <input
                type="email"
                id="rf-email"
                name="email"
                autocomplete="email"
                placeholder="So we can let you know if we publish it"
              />
            </div>

            <div class="form-field">
              <label for="rf-details">Anything else? (optional)</label>
              <textarea
                id="rf-details"
                name="details"
                rows="3"
                placeholder="What would you want the guide to cover?"></textarea>
            </div>

            <button type="submit" class="btn btn-primary btn-lg form-submit">Submit request</button>
          </form>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .page-hero {
    background:
      radial-gradient(
        ellipse 80% 60% at 50% 0%,
        color-mix(in srgb, var(--ql-violet) 10%, transparent) 0%,
        transparent 70%
      ),
      var(--ql-white);
    padding: 64px 0;
  }

  .page-hero-inner {
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
  }
  .page-hero-inner h1 {
    font-weight: 800;
    font-size: clamp(36px, 6vw, 72px);
    letter-spacing: -0.025em;
    line-height: 1.04;
    margin: 0;
  }

  .page-hero-sub {
    font-size: clamp(16px, 1.6vw, 19px);
    line-height: 1.65;
    color: var(--fg-2);
    margin: 0;
  }

  .guide-catalog {
    padding-top: 0;
  }

  .catalog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }
  @media (min-width: 640px) {
    .catalog-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1024px) {
    .catalog-grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }

  .catalog-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 28px;
    border-radius: 20px;
    border: 1px solid var(--border);
    background: var(--ql-white);
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.2s var(--ease-out),
      box-shadow 0.2s var(--ease-out),
      transform 0.2s var(--ease-out);
  }
  .catalog-card:hover {
    border-color: color-mix(in srgb, var(--ql-violet) 40%, transparent);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .catalog-eyebrow {
    font-size: 11px;
  }

  .catalog-card h2 {
    font-family: var(--font-display), system-ui;
    font-weight: 700;
    font-size: 19px;
    letter-spacing: -0.01em;
    line-height: 1.3;
    margin: 0;
    color: var(--fg-1);
  }

  .catalog-card p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--fg-2);
    margin: 0;
  }

  .catalog-footer {
    margin-top: auto;
    padding-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .catalog-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display), system-ui;
    font-weight: 700;
    font-size: 12px;
    color: var(--ql-violet);
  }
  .catalog-meta-dot {
    width: 3px;
    height: 3px;
    border-radius: 999px;
    background: var(--fg-3);
  }

  .catalog-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-display), system-ui;
    font-weight: 700;
    font-size: 13px;
    color: var(--ql-violet);
  }

  .request-section {
    padding-top: 0;
    scroll-margin-top: 100px;
  }

  .request-card {
    max-width: 640px;
    margin: 0 auto;
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: 24px;
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .request-copy {
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-align: center;
  }

  .request-copy h2 {
    font-family: var(--font-display), system-ui;
    font-weight: 800;
    font-size: clamp(24px, 3.5vw, 32px);
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--fg-1);
  }

  .request-copy p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--fg-2);
    margin: 0;
  }

  .request-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .request-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-field label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-2);
    font-family: var(--font-body);
  }

  .form-field input,
  .form-field textarea {
    width: 100%;
    background: var(--ql-white);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 10px 14px;
    font-size: 15px;
    font-family: var(--font-body);
    color: var(--fg-1);
    outline: none;
    transition:
      border-color 0.18s ease,
      box-shadow 0.18s ease;
    box-sizing: border-box;
  }

  .form-field input::placeholder,
  .form-field textarea::placeholder {
    color: var(--fg-3);
  }

  .form-field input:focus,
  .form-field textarea:focus {
    border-color: var(--ql-violet);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--ql-violet) 15%, transparent);
  }

  .form-field textarea {
    resize: vertical;
    min-height: 80px;
    line-height: 1.5;
  }

  .form-submit {
    align-self: center;
  }
</style>
