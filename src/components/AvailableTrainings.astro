---
const trainings = [
  {
    id: "secure-coding",
    title: "Secure Coding Training",
    tagline: "Build security into everyday development.",
    desc: "We teach developers why vulnerabilities happen, how insecure patterns appear in real code, and how to prevent them before production. Training is tailored to your technology, architecture, and development workflow.",
    bullets: [
      "Spot risky patterns during development",
      "Understand authentication, authorization, access control, APIs, error handling, and common data risks",
      "Make safer design choices before code review catches them",
      "Learn to recognize and fix issues in your own codebase",
      "Build security habits that carry forward into future work",
    ],
    addon:
      "<strong> Secure Development Lifecycle Review </strong><br />" +
      "We help your team identify where security guidance, checks, and ownership should fit throughout planning, development, review, and release.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
  },
  {
    id: "findings-based",
    title: "Findings Based Training",
    tagline: "Turn pentest findings into lasting understanding.",
    desc: "We transform your findings into practical lessons. Developers learn what caused each issue, how it could appear elsewhere, and how to fix the underlying pattern instead of only applying the mitigation recommendations.",
    bullets: [
      "Understand the root cause behind past findings",
      "Recognize similar patterns in code",
      "Apply practical, code-level fixes",
      "Improve communication between security and engineering",
      "Reduce repeat issues over time",
      "Reduce repeat issues over time"
    ],
    addon:
      "<strong>Remediation Review</strong><br />" +
      "After training, we review your team’s planned or completed fixes to confirm the root cause was addressed and identify related patterns before they become future findings.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>`,
  },
  {
    id: "ai-llm",
    title: "AI and LLM Security Training",
    tagline: "Secure AI starts with understanding how it works.",
    desc: "We teach teams how AI systems work, where risks enter, and when AI may not be the right solution. Whether you are planning an integration or improving one already in use, training is tailored to your models, stack, and workflows.",
    bullets: [
      "Understand prompt injection and data leakage risks",
      "Design safer AI workflows and tool integrations",
      "Apply practical guardrails, permissions, and logging",
      "Recognize where traditional application security still matters",
      "Decide when AI is the right solution and when it is not"

    ],
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M9 9h.01M15 9h.01M9 15h6"/><circle cx="12" cy="12" r="3"/></svg>`,
  },
  {
    id: "product-leadership",
    title: "Security for Product and Leadership Teams",
    tagline: "Make technical decisions with confidence.",
    desc: "We teach product managers, team leads, and executives the technical concepts behind application, AI, and data security. Participants learn enough to understand findings, ask informed questions, discuss tradeoffs, and make informed decisions without needing a technical liaison.",
    bullets: [
      "Understand how common vulnerabilities happen",
      "Prioritize remediation with better context",
      "Connect technical risks to business decisions",
      "Understand application, AI, and data security risks at a decision-making level"
    ],
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  },
];
---

<section class="available-trainings section section-lg" id="types">
  <div class="container">
    <div class="available-trainings-head">
      <span class="eyebrow">Available Trainings</span>
      <h2>Choose a training that&rsquo;s right for <span class="gradient-text">your team</span></h2>
      <p class="available-trainings-sub">
        Not a security presentation you&rsquo;ll soon forget added to the first slide. Every
        workshop is shaped around your team&rsquo;s technology, experience level, products and
        processes, and recent security context &mdash; it&rsquo;s to teach the concepts that matter
        for the way your team actually builds.
      </p>
    </div>

    <div class="available-trainings-grid">
      {
        trainings.map((t) => (
          <article class="available-training-card" id={t.id}>
            <div class="available-training-icon" set:html={t.icon} />
            <div class="available-training-body">
              <h3>{t.title}</h3>
              <p class="available-training-tagline">{t.tagline}</p>
              <p class="available-training-desc">{t.desc}</p>
              <ul class="available-training-bullets">
                {t.bullets.map((b) => (
                  <li>
                    <svg
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                    {b}
                  </li>
                ))}
              </ul>
              {t.addon && (
                <div class="available-training-addon">
                  <hr class="available-training-hr" />
                  <p class="available-training-addon-label">Optional add-on</p>
                  <p class="available-training-addon-text" set:html={t.addon} />
                </div>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .available-trainings {
    background: #fff;
  }

  .available-trainings-head {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 56px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .available-trainings-sub {
    font-size: var(--fs-body);
    line-height: var(--lh-loose);
    color: var(--fg-2);
    max-width: 60ch;
  }

  .available-trainings-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 880px) {
    .available-trainings-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .available-training-card {
    scroll-margin-top: 100px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    transition:
      transform 0.22s var(--ease-out),
      box-shadow 0.22s var(--ease-out),
      border-color 0.22s var(--ease-out);
  }

  .available-training-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
    border-color: var(--ql-lavender-400);
  }

  @media (min-width: 760px) {
    .available-training-card {
      padding: 40px;
    }
  }

  .available-training-icon {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: linear-gradient(135deg, #260070 0%, #7b2adb 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    flex-shrink: 0;
    box-shadow: 0 8px 24px rgba(123, 42, 219, 0.28);
  }

  .available-training-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .available-training-body h3 {
    font-size: var(--fs-h3);
    color: var(--fg-1);
  }

  .available-training-tagline {
    font-size: var(--fs-small);
    font-weight: var(--fw-semi);
    color: var(--ql-violet);
    font-style: italic;
    line-height: var(--lh-normal);
  }

  .available-training-desc {
    font-size: var(--fs-small);
    line-height: var(--lh-loose);
    color: var(--fg-2);
  }

  .available-training-bullets {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .available-training-bullets li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: var(--fs-small);
    color: var(--fg-2);
    line-height: var(--lh-normal);
  }

  .available-training-bullets li svg {
    flex-shrink: 0;
    color: var(--ql-magenta);
    margin-top: 1px;
  }

  .available-training-addon {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 4px;
  }

  .available-training-hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 0 0 4px;
  }

  .available-training-addon-label {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: var(--fs-caption);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-3);
  }

  .available-training-addon-text {
    font-size: var(--fs-small);
    line-height: var(--lh-loose);
    color: var(--fg-2);
  }
</style>
