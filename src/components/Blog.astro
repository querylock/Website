---
const posts = [
  {
    category: "AI Security",
    readTime: "8 min read",
    title: "Prompt injection isn't going away. Here's the defense playbook.",
    excerpt:
      "Indirect prompt injection through retrieved content is now the more common attack vector. A layered approach beats any single mitigation.",
    cover: "purple",
    glyph: "ai",
  },
  {
    category: "App Security",
    readTime: "6 min read",
    title: "Why your pentest keeps finding the same OWASP categories.",
    excerpt:
      "Five years of pentest data on what actually shows up in reports — and the three knowledge gaps that explain most of it.",
    cover: "violet",
    glyph: "lock",
  },
  {
    category: "Cloud Security",
    readTime: "7 min read",
    title: "A practitioner's read of the 2026 AWS attack surface.",
    excerpt:
      "What's changed since last year: IMDSv2 default behavior, the new IAM Identity Center patterns, and the one S3 setting most teams still miss.",
    cover: "magenta",
    glyph: "cloud",
  },
];

const patternCells: { x: number; y: number; sz: number }[] = [];
for (let i = 0; i < 40; i++) {
  patternCells.push({
    x: (i * 47 + 13) % 600,
    y: (i * 71 + 23) % 380,
    sz: i % 6 === 0 ? 8 : 4,
  });
}

const glyphs: Record<string, string> = {
  ai: `<svg width="64" height="64" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2"><circle cx="32" cy="32" r="8"/><circle cx="14" cy="18" r="4"/><circle cx="50" cy="18" r="4"/><circle cx="14" cy="46" r="4"/><circle cx="50" cy="46" r="4"/><path d="M18 20l10 9M46 20l-10 9M18 44l10-9M46 44l-10-9"/></svg>`,
  lock: `<svg width="64" height="64" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2"><rect x="14" y="28" width="36" height="26" rx="4"/><path d="M22 28v-8a10 10 0 0120 0v8"/><circle cx="32" cy="40" r="3" fill="currentColor" stroke="none"/></svg>`,
  cloud: `<svg width="68" height="68" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2"><path d="M48 42a10 10 0 000-20 14 14 0 00-27-2A10 10 0 1014 42z"/></svg>`,
};
---

<section class="blog-section section section-lg" id="blog">
  <div class="container">
    <div class="mx-auto mb-14 flex max-w-[760px] flex-col items-center gap-4 text-center">
      <span class="eyebrow">From the blog</span>
      <h2 class="font-extrabold text-[clamp(32px,4.6vw,52px)] leading-[1.05] tracking-[-0.02em] text-balance">
        Field notes from practitioners.
      </h2>
      <p class="max-w-[60ch] text-[17px] leading-[1.55] text-[var(--fg-2)]">
        Short reads on the stuff we ran into this month. Always free, always practical.
      </p>
    </div>

    <div class="blog-grid">
      {
        posts.map((p) => (
          <a href="#" class="blog-card">
            <div class={`blog-cover ${p.cover}`}>
              <svg
                class="pattern"
                viewBox="0 0 600 380"
                preserveAspectRatio="xMidYMid slice"
                width="100%"
                height="100%"
              >
                {patternCells.map((c, i) => (
                  <rect key={i} x={c.x} y={c.y} width={c.sz} height={c.sz} fill="#fff" />
                ))}
              </svg>
              <div class="glyph" set:html={glyphs[p.glyph]} />
            </div>
            <div class="blog-body">
              <div class="blog-meta">
                <span class="blog-category">{p.category}</span>
                <span style="color:var(--ql-ink-200)">·</span>
                <span class="blog-readtime">{p.readTime}</span>
              </div>
              <h3>{p.title}</h3>
              <p>{p.excerpt}</p>
              <span class="blog-readmore">
                Read article <span class="arrow">→</span>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .blog-section {
    background: var(--ql-white);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  @media (min-width: 760px) {
    .blog-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1080px) {
    .blog-grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }

  .blog-card {
    background: var(--ql-white);
    border: 1px solid var(--border);
    border-radius: 22px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    transition:
      transform 0.22s var(--ease-out),
      box-shadow 0.22s var(--ease-out),
      border-color 0.22s var(--ease-out);
  }
  .blog-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 24px 56px color-mix(in srgb, var(--ql-deep-purple) 14%, transparent);
    border-color: var(--ql-lavender-400);
  }

  .blog-cover {
    aspect-ratio: 16/10;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .blog-cover .pattern {
    position: absolute;
    inset: 0;
    opacity: 0.18;
  }
  .blog-cover .glyph {
    position: relative;
    color: var(--ql-white);
    opacity: 0.9;
  }
  .blog-cover.purple {
    background: linear-gradient(135deg, var(--ql-deep-purple) 0%, var(--ql-violet) 100%);
  }
  .blog-cover.violet {
    background: linear-gradient(135deg, var(--ql-purple-600) 0%, var(--ql-magenta) 100%);
  }
  .blog-cover.magenta {
    background: linear-gradient(135deg, var(--ql-violet) 0%, var(--ql-magenta) 100%);
  }

  .blog-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }
  .blog-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .blog-category {
    color: var(--ql-violet);
  }
  .blog-readtime {
    color: var(--fg-3);
  }
  .blog-card h3 {
    font-weight: 800;
    font-size: 20px;
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin: 0;
  }
  .blog-card p {
    font-size: 14px;
    line-height: 1.55;
    color: var(--fg-2);
    margin: 0;
  }

  .blog-readmore {
    margin-top: auto;
    padding-top: 8px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 13px;
    color: var(--ql-violet);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .blog-readmore .arrow {
    transition: transform 0.22s var(--ease-out);
    display: inline-block;
  }
  .blog-card:hover .blog-readmore .arrow {
    transform: translateX(4px);
  }
</style>
