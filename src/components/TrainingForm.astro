<section class="training-form-section section section-lg" id="contact">
  <div class="container">
    <div class="training-form-layout">
      <div class="training-form-copy">
        <span class="eyebrow">Get Started</span>
        <h2>Bring QueryLock Training to Your Team</h2>
        <p>
          Tell us what your team is working on, what you want to improve, and what kind of training
          you are interested in. We will help shape the right workshop for your team, whether you
          already know exactly what you need or are still figuring out where to start.
        </p>
        <div class="training-form-note">
          <p>
            Not sure what training your team needs yet? Reach out anyway. We can help you find the
            right starting point.
          </p>
        </div>
      </div>

      <div class="training-form-card">
        <form class="training-form" name="training-request" method="POST" data-netlify="true">
          <input type="hidden" name="form-name" value="training-request" />

          <div class="form-row">
            <div class="form-field">
              <label for="tf-name">Name</label>
              <input type="text" id="tf-name" name="name" autocomplete="name" required />
            </div>
            <div class="form-field">
              <label for="tf-email">Work Email</label>
              <input type="email" id="tf-email" name="email" autocomplete="email" required />
            </div>
          </div>

          <div class="form-row">
            <div class="form-field">
              <label for="tf-company">Company</label>
              <input type="text" id="tf-company" name="company" autocomplete="organization" />
            </div>
            <div class="form-field">
              <label for="tf-team-size">Team Size (Approximate)</label>
              <input type="text" id="tf-team-size" name="team_size" placeholder="e.g. 12" />
            </div>
          </div>

          <div class="form-field">
            <label for="tf-training-type">Training Type</label>
            <select id="tf-training-type" name="training_type">
              <option value="secure-coding">Secure Coding Training</option>
              <option value="findings-based">Findings Based Training</option>
              <option value="ai-llm">AI and LLM Security Training</option>
              <option value="product-leadership">Security for Product and Leadership Teams</option>
              <option value="unsure">Not Sure Yet</option>
            </select>
          </div>

          <div class="form-field">
            <label>Preferred Format</label>
            <div class="format-options">
              <label class="format-option">
                <input type="radio" name="format" value="virtual" checked />
                <span>Virtual</span>
              </label>
              <label class="format-option">
                <input type="radio" name="format" value="in-person" />
                <span>In Person</span>
              </label>
              <label class="format-option">
                <input type="radio" name="format" value="either" />
                <span>Either</span>
              </label>
            </div>
          </div>

          <div class="form-field">
            <label for="tf-goals">What Would You Like to Get Out of This Training?</label>
            <textarea id="tf-goals" name="goals" rows="4"></textarea>
          </div>

          <div class="form-field">
            <label for="tf-anything-else">Anything Else?</label>
            <textarea id="tf-anything-else" name="anything_else" rows="4"></textarea>
          </div>

          <button type="submit" class="btn btn-primary btn-lg form-submit">Schedule Training</button
          >
        </form>
      </div>
    </div>
  </div>
</section>

