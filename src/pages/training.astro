---
import Layout from "../layouts/Layout.astro";
import TrainingTeaser from "../components/TrainingTeaser.astro";
import HowItWorks from "../components/HowItWorks.astro";
import WhyChooseUs from "../components/WhyChooseUs.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav";
import FAQ from "../components/FAQ";
import AvailableTrainings, { trainings } from "../components/AvailableTrainings.astro";
import TrainingForm from "../components/TrainingForm.astro";

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "QueryLock Security Training",
  description:
    "Practitioner-led security training for engineering, security, and leadership teams. Live, virtual or onsite, scoped to your stack.",
  provider: {
    "@type": "Organization",
    name: "QueryLock",
    url: "https://querylock.com/",
  },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Training Tracks",
    itemListElement: trainings.map((t) => ({
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: t.title,
        description: t.desc,
      },
    })),
  },
};
---

<Layout
  title="Training | QueryLock"
  description="Practitioner-led security training for engineering, security, and leadership teams. Live, virtual or onsite, scoped to your stack."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />
  <Nav active="training" client:load />
  <main>
    <section class="training-hero">
      <div class="container">
        <div class="training-hero-inner">
          <span class="hero-badge"><span class="dot"></span>How training works</span>
          <h1>Tailored Training for <span class="gradient-text">Lasting Security</span></h1>
          <p class="lead">
            Most security training teaches people to recognize terms. QueryLock teaches developers
            why vulnerabilities happen, how they appear in real code, and how to prevent them before
            production. Every session combines clear instruction, hands-on practice, and examples
            from the systems your team actually uses. Your team leaves knowing what to do
            differently and why it matters.
          </p>
          <div class="training-hero-ctas">
            <a href="#contact" class="btn btn-primary btn-lg">
              Schedule a session
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"></path></svg
              >
            </a>
            <a href="#types" class="btn btn-outline btn-lg">See training formats</a>
          </div>
        </div>
      </div>
    </section>
    <HowItWorks />
    <AvailableTrainings />
    <TrainingForm />
  </main>
  <Footer />
</Layout>

<style>
  .training-hero {
    background:
      radial-gradient(
        ellipse 80% 60% at 50% 0%,
        color-mix(in srgb, var(--ql-violet) 12%, transparent) 0%,
        transparent 70%
      ),
      var(--ql-white);
    padding: 80px 0 64px;
  }
  @media (min-width: 760px) {
    .training-hero {
      padding: 96px 0 80px;
    }
  }

  .training-hero-inner {
    max-width: 840px;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .training-hero-inner h1 {
    font-weight: 800;
    font-size: clamp(36px, 6vw, 72px);
    letter-spacing: -0.025em;
    line-height: 1.04;
    margin: 24px 0;
  }

  .training-hero-inner .lead {
    font-size: clamp(16px, 1.6vw, 19px);
    line-height: 1.65;
    color: var(--fg-2);
    max-width: 680px;
    margin: 0 auto;
  }

  .training-hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
    justify-content: center;
  }
</style>
