---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import FreeResources from '../components/FreeResources.astro';
import Nav from '../components/Nav';
import GuideSeries from '../components/GuideSeries';
import Newsletter from '../components/Newsletter';
import FinalCTA from "../components/FinalCTA.astro";
---

<Layout
  title="Learning — QueryLock"
  description="Short, practical guides that make cybersecurity and AI finally click. No technical background needed."
>
  <Nav active="learning" client:load />
  <main>
    <section class="page-hero section-lg" id="guides" style="min-height: auto; padding: 64px 0;">
      <div class="container">
        <div class="page-hero-inner">
          <span class="hero-badge"><span class="dot"></span>The guide catalog</span>
          <h1>Technology shouldn&rsquo;t feel like a <span class="gradient-text">club you need permission to join.</span></h1>
          <p class="page-hero-sub">Explore short, practical guides that make complex topics finally click. The only prerequisite is curiosity &mdash; no technical background needed.</p>
          <a href="https://gumroad.com" target="_blank" rel="noopener" class="btn btn-primary btn-lg" style="margin-top:32px">
            View guides on Gumroad
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 17L17 7M7 7h10v10"/></svg>
          </a>
          <p>Don't see the guide you want? Request one at <a href="mailto:info@querylock.com">info@querylock.com</a></p>
        </div>
      </div>
    </section>
    <!--<GuideSeries client:load />-->
    <!--<FreeResources />-->
    <!--<Newsletter client:load />-->
    <FinalCTA />

  </main>
  <Footer />
</Layout>
