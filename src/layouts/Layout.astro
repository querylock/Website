---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "QueryLock — Cybersecurity education made practical." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/assets/querylock-mark.svg" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  html {
    height: 100%;
  }

  body {
    min-height: 100%;
  }

  body {
    display: flex;
    flex-direction: column;
  }

  body > main {
    flex: 1;
  }
</style>
