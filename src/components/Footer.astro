---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" aria-label="QueryLock home" style="display:inline-block">
          <img
            src="/assets/querylock-horizontal-on-deep-purple.jpg"
            alt="QueryLock"
            style="height:32px;width:auto"
          />
        </a>
        <p class="footer-brand-text">
          Cybersecurity education that helps curious learners understand security and helps teams
          build safer software from the start.
        </p>
        <div style="display:flex;gap:10px;margin-top:24px">
          <a
            href="https://www.linkedin.com/company/querylock/about/"
            target="_blank"
            style="width:36px;height:36px;border-radius:999px;background:rgba(255,255,255,.08);display:inline-flex;align-items:center;justify-content:center;color:#fff"
            aria-label="LinkedIn"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"
              ><path
                d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM0 8h5v16H0V8zm7.5 0H12v2.2h.07c.63-1.2 2.17-2.46 4.46-2.46 4.77 0 5.65 3.14 5.65 7.23V24h-5v-7.5c0-1.79-.03-4.1-2.5-4.1-2.5 0-2.88 1.95-2.88 3.97V24h-5V8z"
              ></path></svg
            >
          </a>
          <a
            href="https://medium.com/@querylock"
            target="_blank"
            style="width:36px;height:36px;border-radius:999px;background:rgba(255,255,255,.08);display:inline-flex;align-items:center;justify-content:center;color:#fff"
            aria-label="Medium"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"
              ><path
                d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"
              ></path></svg
            >
          </a>
          <a
            href="https://github.com/querylock"
            target="_blank"
            style="width:36px;height:36px;border-radius:999px;background:rgba(255,255,255,.08);display:inline-flex;align-items:center;justify-content:center;color:#fff"
            aria-label="GitHub"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"
              ><path
                d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"
              ></path></svg
            >
          </a>
        </div>
      </div>
      <div class="footer-col">
        <h4>Guides</h4>
        <ul>
          <li><a href="/learning">Explore the guides</a></li>
          <li><a href="mailto:info@querylock.com?subject=Guide%20Request">Request a guide</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Training</h4>
        <ul>
          <li><a href="/training#types">Secure coding</a></li>
          <li><a href="/training#types">Findings-based</a></li>
          <li><a href="/training#types">AI and LLM security</a></li>
          <li><a href="/training#types">Product and leadership</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>QueryLock</h4>
        <ul>
          <li><a href="/about">About</a></li>
          <li><a href="/faq">FAQ</a></li>
          <li><a href="mailto:info@querylock.com">Contact</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2026 QueryLock. Security through education.</span>
      <span style="display:flex;gap:24px">
        <a href="/privacy" style="color:inherit">Privacy</a>
        <a href="/terms" style="color:inherit">Terms</a>
      </span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--ql-deep-purple);
    color: rgba(255, 255, 255, 0.75);
    padding: 64px 0 0;
    position: relative;
  }
  .footer::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(203, 68, 239, 0.4) 50%,
      transparent 100%
    );
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    padding-bottom: 48px;
  }
  @media (min-width: 760px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr 1fr;
    }
  }

  .footer-brand-text {
    font-size: 14px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.55);
    margin: 20px 0 0;
    max-width: 280px;
  }

  .footer h4 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
    margin: 0 0 16px;
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .footer-col a {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.65);
    text-decoration: none;
    transition: color 0.18s;
  }
  .footer-col a:hover {
    color: rgba(255, 255, 255, 0.95);
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 20px 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.38);
  }
  .footer-bottom a {
    color: inherit;
    text-decoration: none;
    transition: color 0.18s;
  }
  .footer-bottom a:hover {
    color: rgba(255, 255, 255, 0.65);
  }
</style>
