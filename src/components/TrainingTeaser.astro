---
import { training } from "../data/content";

const glyphs: Record<string, string> = {
  "live-virtual": `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="14" rx="2"/><path d="M8 22h8M12 18v4"/></svg>`,
  "private-virtual": `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="10" r="2.5"/><path d="M3 20a6 6 0 0112 0M14 20a5 5 0 017 0"/></svg>`,
  onsite: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12l9-8 9 8"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/></svg>`,
};
---

<section class="training-section section section-lg" id="training">
  <div class="container">
    <div class="mx-auto mb-14 flex max-w-[760px] flex-col items-center gap-4 text-center">
      <span class="eyebrow">QueryLock Training</span>
      <h2 class="font-extrabold text-[clamp(32px,4.6vw,52px)] leading-[1.05] tracking-[-0.02em] text-balance">
        Annual pentest, <span class="gradient-text">same findings</span>, every year?
      </h2>
      <p class="max-w-[60ch] text-[17px] leading-[1.55] text-[var(--fg-2)]">
        That&rsquo;s a knowledge problem &mdash; not a tools problem. Live, practitioner-led
        sessions for engineering, security, and leadership teams. Three formats.
      </p>
    </div>

    <div class="training-grid">
      {
        training.map((t, i) => (
          <article class={`training-card ${i === 1 ? "popular" : ""}`}>
            <div class="glyph" set:html={glyphs[t.id] ?? glyphs["onsite"]} />
            <h3>{t.title}</h3>
            <p class="desc">{t.desc}</p>
            <div style="display:flex;gap:6px;margin-top:4px">
              <span class="pill pill-soft">{t.audience}</span>
            </div>
            <div class="price">
              <div class="price-from">Starting from</div>
              <div>
                <span class="price-value">{t.priceLabel}</span>{" "}
                <span class="price-unit">{t.priceUnit}</span>
              </div>
              <div style="font-family:var(--font-body);font-size:12px;color:var(--fg-3);margin-top:6px">
                {t.priceFootnote}
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="training-cta-row">
      <a href="/training#contact" class="btn btn-primary">
        See training topics &amp; request a session
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"></path></svg
        >
      </a>
    </div>
  </div>
</section>

<style>
  .training-section {
    background: var(--ql-ink-50);
  }

  .training-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }
  @media (min-width: 880px) {
    .training-grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }

  .training-card {
    background: var(--ql-white);
    border: 1px solid var(--border);
    border-radius: 22px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition:
      transform 0.22s var(--ease-out),
      box-shadow 0.22s var(--ease-out);
    position: relative;
    overflow: hidden;
  }
  .training-card.popular {
    border-color: var(--ql-magenta);
  }
  .training-card.popular::before {
    content: "Most flexible";
    position: absolute;
    top: 16px;
    right: 16px;
    background: linear-gradient(135deg, var(--ql-violet) 0%, var(--ql-magenta) 100%);
    color: var(--ql-white);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 10.5px;
    padding: 4px 10px;
    border-radius: 999px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .training-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 48px color-mix(in srgb, var(--ql-deep-purple) 12%, transparent);
  }

  .training-card .glyph {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--ql-violet) 12%, transparent) 0%,
      color-mix(in srgb, var(--ql-magenta) 12%, transparent) 100%
    );
    border: 1px solid color-mix(in srgb, var(--ql-violet) 18%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ql-violet);
    margin-bottom: 4px;
  }
  .training-card h3 {
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.01em;
    line-height: 1.15;
    margin: 0;
  }
  .training-card .desc {
    font-size: 14px;
    line-height: 1.55;
    color: var(--fg-2);
    margin: 0;
  }

  .training-card .price {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--ql-ink-100);
  }
  .training-card .price-from {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-3);
    margin-bottom: 4px;
  }
  .training-card .price-value {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 28px;
    letter-spacing: -0.02em;
    color: var(--ql-deep-purple);
  }
  .training-card .price-unit {
    font-weight: 500;
    font-size: 14px;
    color: var(--fg-3);
  }

  .training-cta-row {
    display: flex;
    justify-content: center;
    margin-top: 40px;
  }
</style>
