---
import { training } from '../data/content';

const glyphs: Record<string, string> = {
  'live-virtual': `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="14" rx="2"/><path d="M8 22h8M12 18v4"/></svg>`,
  'private-virtual': `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="10" r="2.5"/><path d="M3 20a6 6 0 0112 0M14 20a5 5 0 017 0"/></svg>`,
  'onsite': `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12l9-8 9 8"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/></svg>`,
};
---

<section class="training-section section section-lg" id="training">
  <div class="container">
    <div class="section-head-c">
      <span class="eyebrow">QueryLock Training</span>
      <h2>Annual pentest, <span class="gradient-text">same findings</span>, every year?</h2>
      <p>That&rsquo;s a knowledge problem &mdash; not a tools problem. Live, practitioner-led sessions for engineering, security, and leadership teams. Three formats.</p>
    </div>

    <div class="training-grid">
      {training.map((t, i) => (
        <article class={`training-card ${i === 1 ? 'popular' : ''}`}>
          <div class="glyph" set:html={glyphs[t.id] ?? glyphs['onsite']} />
          <h3>{t.title}</h3>
          <p class="desc">{t.desc}</p>
          <div style="display:flex;gap:6px;margin-top:4px">
            <span class="pill pill-soft">{t.audience}</span>
          </div>
          <div class="price">
            <div class="price-from">Starting from</div>
            <div>
              <span class="price-value">{t.priceLabel}</span>{' '}
              <span class="price-unit">{t.priceUnit}</span>
            </div>
            <div style="font-family:var(--font-body);font-size:12px;color:var(--fg-3);margin-top:6px">{t.priceFootnote}</div>
          </div>
        </article>
      ))}
    </div>

    <div class="training-cta-row">
      <a href="/training#contact" class="btn btn-primary">
        See training topics &amp; request a session
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
  </div>
</section>
