---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Offerings from "../components/Offerings.astro";
import WhyChooseUs from "../components/WhyChooseUs.astro";
import TwoPaths from "../components/TwoPaths.astro";
import TrainingTeaser from "../components/TrainingTeaser.astro";
import Blog from "../components/Blog.astro";
import FreeResources from "../components/FreeResources.astro";
import Belief from "../components/Belief.astro";
import FinalCTA from "../components/FinalCTA.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav";
import GuideSeries from "../components/GuideSeries";
import Newsletter from "../components/Newsletter";

const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "QueryLock",
  url: "https://querylock.com/",
  logo: "https://querylock.com/assets/querylock-transparent.png",
  description:
    "QueryLock is a cybersecurity education company that makes security easier to understand through practical guides and hands-on training.",
  sameAs: [
    "https://www.linkedin.com/company/querylock/about/",
    "https://medium.com/@querylock",
    "https://github.com/querylock",
  ],
};

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "QueryLock",
  url: "https://querylock.com/",
  description:
    "QueryLock makes cybersecurity easier to understand with practical guides and hands-on security training built around your team's needs.",
};
---

<Layout
  title="QueryLock | Security education made practical"
  description="QueryLock makes cybersecurity easier to understand with practical guides and hands-on security training built around your team's needs."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
  <Nav active="home" client:load />
  <main>
    <Hero />
    <WhyChooseUs />
    <Offerings />
    <FreeResources />
    <Belief />
  </main>
  <Footer />
</Layout>
